rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 로그인된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // users 컬렉션에서 사용자 역할(role) 조회
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 교사(teacher) 확인:
    // 1) 관리자 이메일(adh103006@gmail.com)인 경우
    // 2) users/{uid} 문서의 role이 'teacher'인 경우
    // 3) auth 토큰 클레임의 role이 'teacher'인 경우
    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.email == 'adh103006@gmail.com'
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == 'teacher')
        || (request.auth.token.keys().hasAny(['role']) && request.auth.token.role == 'teacher')
      );
    }

    // 학생(student) 확인: 교사가 아닌 로그인 사용자는 기본적으로 학생
    function isStudent() {
      return isAuthenticated() && !isTeacher();
    }

    // 사용자 정보 (/users/{userId}) 컬렉션 규칙
    match /users/{userId} {
      allow read: if isAuthenticated();
      // 교사는 모든 사용자 관리 가능, 학생은 본인 문서만 등록/수정 (role을 임의로 teacher로 변경하지 못하게 제한)
      allow create, update: if isAuthenticated() && (
        isTeacher() ||
        (request.auth.uid == userId && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'student'))
      );
      allow delete: if isTeacher();
    }

    // 담벼락 메모 (/memos/{memoId}) 컬렉션 규칙
    match /memos/{memoId} {
      // 담벼락의 모든 메모는 누구나 조회 가능
      allow read: if true;

      // 메모 생성:
      // - 5글자 이상 50글자 이하
      // - 교사는 모든 권한 (자유롭게 생성 가능)
      // - 학생은 본인 uid로만 생성 가능 (request.resource.data.uid == request.auth.uid)
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['text', 'createdAt', 'uid'])
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'uid', 'authorName'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && (request.resource.data.createdAt is timestamp || request.resource.data.createdAt is int)
        && request.resource.data.uid is string
        && (
          isTeacher() ||
          (isStudent() && request.resource.data.uid == request.auth.uid)
        );

      // 메모 수정:
      // - 교사는 모든 메모 수정 가능
      // - 학생은 본인이 작성한 메모만 수정 가능 (다른 사람 것은 건들지 못함)
      allow update: if isAuthenticated() && (
        isTeacher() ||
        (isStudent() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
      );

      // 메모 삭제:
      // - 교사는 모든 메모 삭제 가능
      // - 학생은 본인이 작성한 메모만 삭제 가능 (다른 사람 것은 건들지 못함)
      allow delete: if isAuthenticated() && (
        isTeacher() ||
        (isStudent() && resource.data.uid == request.auth.uid)
      );
    }

    // 그 외 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
