rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /memos/{memoId} {
      allow read: if true;

      // 5글자 이상 50글자 이하의 메모만 저장 가능하도록 제한
      allow create: if request.resource.data.keys().hasOnly(['text', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5
        && request.resource.data.text.size() <= 50
        && (
          (request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time)
          || (request.resource.data.createdAt is int)
        );

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
